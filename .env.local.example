# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Voice provider ────────────────────────────────────────────────────────────
# "retell" (default) or "pipecat" (Groq-based voice agent via the Tom bot)
VOICE_PROVIDER=pipecat

# ── Retell AI (used when VOICE_PROVIDER=retell) ───────────────────────────────
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# ── Pipecat / Tom voice bot (used when VOICE_PROVIDER=pipecat) ─────────────────
# URL of the running Groq/Pipecat bot (bot.py). Exposed to the browser.
NEXT_PUBLIC_TOM_BOT_URL=http://localhost:7860
# Optional shared secret: bot sends it as x-bot-secret when POSTing the transcript back.
BOT_WEBHOOK_SECRET=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=charlie@yourdomain.com

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
